# Copy to .env. Everything here is optional; the engine works fully without it.

# Set to off to disable every LLM call (the recommended stack is identical either way).
STACKSENSE_LLM=on

# Only needed for the optional description parsing and rewording features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# HOST=127.0.0.1
# PORT=8000
